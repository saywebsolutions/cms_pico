{% extends "base.twig" %}

{% block content %}
    {% if meta.title %}
    <h1>{{ meta.title }}</h1>
    {% endif %}

    {% if meta.tags %}
    <p class="tags">
        {% for tag in meta.tags %}
        {% set tagPage = null %}
        {% for tp in pages("blog/tags") %}
            {% if tp.meta.tag|lower == tag|lower %}{% set tagPage = tp %}{% endif %}
        {% endfor %}
        {% if tagPage %}<a class="tag" href="{{ tagPage.url }}">{{ tag }}</a>{% else %}<span class="tag">{{ tag }}</span>{% endif %}
        {% endfor %}
    </p>
    {% endif %}

    {{ content|raw }}

    {% if config.comments_url %}
    <section id="comments">
        <h2>Comments</h2>
        <div id="remark42"></div>
        <script nonce="{{ config.csp_nonce }}">
            var remark_config = {
                host: '{{ config.comments_url }}',
                site_id: '{{ config.nextcloud_site }}',
                url: window.location.origin + window.location.pathname,
                theme: 'light',
                locale: 'sv-SE'
            };
        </script>
        <script defer nonce="{{ config.csp_nonce }}" src="{{ config.comments_url }}/web/embed.js"></script>
    </section>
    {% endif %}
{% endblock %}
