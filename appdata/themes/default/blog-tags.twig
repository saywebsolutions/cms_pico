{% extends "base.twig" %}

{% block content %}
    <h1>{{ meta.title }}</h1>

    {% set posts = pages("blog") %}
    {% set tagPages = pages("blog/tags")|sort_by("title") %}
    {% set counts = {} %}
    {% for tp in tagPages %}
        {% set c = 0 %}
        {% set tag = tp.meta.tag|lower %}
        {% for post in posts %}
            {% if post.meta.tags and post.meta.tags|filter(t => t|lower == tag)|length > 0 %}
                {% set c = c + 1 %}
            {% endif %}
        {% endfor %}
        {% set counts = counts|merge({ (tp.id): c }) %}
    {% endfor %}
    {% set maxCount = max(counts|default({'': 1})) %}

    <div class="tag-cloud">
    {% for tp in tagPages %}
        {% set c = counts[tp.id] %}
        {% set ratio = c / maxCount %}
        {% set size = ratio > 0.6 ? 'tag-xl' : (ratio > 0.3 ? 'tag-lg' : (ratio > 0.1 ? 'tag-md' : 'tag-sm')) %}
        <a class="tag {{ size }}" href="{{ tp.url }}">{{ tp.meta.tag }}&nbsp;({{ c }})</a>
    {% endfor %}
    </div>
{% endblock %}
