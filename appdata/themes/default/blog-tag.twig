{% extends "base.twig" %}

{% block content %}
    <h1>{{ meta.title }}</h1>
    <p class="tag-page-nav"><a href="{{ "blog/tags"|link }}">All tags</a></p>

    <section class="blog-posts">
    {% set tag = meta.tag|lower %}
    {% for page in pages("blog")|sort_by("time")|reverse %}
        {% if page.meta.tags and page.meta.tags|filter(t => t|lower == tag)|length > 0 %}
        {% include "partials/post-item.twig" %}
        {% endif %}
    {% endfor %}
    </section>
{% endblock %}
